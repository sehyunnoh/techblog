---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../utils/url';
import { getPublishedPosts, getPostsByTag } from '../../utils/posts';
import { getPublishedGuides, getGuidesByTag } from '../../utils/guides';
import { tagLabel, tagDescription } from '../../tags';

export async function getStaticPaths() {
  // Union of tags in use across both collections — a tag only a guide uses
  // still needs a page built for it, not just tags posts happen to use.
  const [posts, guides] = await Promise.all([getPublishedPosts(), getPublishedGuides()]);
  const tagsInUse = new Set<string>();
  for (const entry of [...posts, ...guides]) {
    for (const tag of entry.data.tags) tagsInUse.add(tag);
  }

  return Promise.all(
    [...tagsInUse].map(async (tag) => ({
      params: { tag },
      props: { tag, posts: await getPostsByTag(tag), guides: await getGuidesByTag(tag) },
    })),
  );
}

const { tag, posts, guides } = Astro.props;
const label = tagLabel(tag);
const desc = tagDescription(tag);
const total = posts.length + guides.length;
---

<BaseLayout
  title={label}
  description={desc || `Posts and guides tagged ${label} on Lleg's study.`}
  path={`/tags/${tag}`}
  narrow
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={withBase('/tags')}>Tags</a>
    <span aria-hidden="true">/</span>
    <span>{label}</span>
  </nav>

  <h1 class="page-title"><span class="hash" aria-hidden="true">#</span>{label}</h1>
  {desc && <p class="page-sub">{desc}</p>}
  <p class="count">{total} {total === 1 ? 'item' : 'items'}</p>

  {
    posts.length > 0 && (
      <section class="section">
        {guides.length > 0 && <h2 class="section__label">Posts</h2>}
        {posts.map((post) => <PostCard post={post} />)}
      </section>
    )
  }

  {
    guides.length > 0 && (
      <section class="section">
        {posts.length > 0 && <h2 class="section__label">Guides</h2>}
        {guides.map((guide) => <PostCard post={guide} kind="guide" />)}
      </section>
    )
  }
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--fg-faint);
    margin-bottom: 1rem;
  }

  .crumbs a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .page-title {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.028em;
    font-weight: 680;
  }

  .hash {
    color: var(--fg-faint);
    font-weight: 500;
  }

  .page-sub {
    margin: 0.5rem 0 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    max-width: 34rem;
    line-height: 1.65;
  }

  .count {
    margin: 0.6rem 0 1.5rem;
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }

  .section {
    margin-top: 1.5rem;
  }

  .section__label {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
</style>
