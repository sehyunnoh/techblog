---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedGuides } from '../../utils/guides';

const guides = await getPublishedGuides();
---

<BaseLayout
  title="Guides"
  description="Reference material on Lleg's study: explainers and how-tos for things worth looking up more than once."
  path="/guides"
  narrow
>
  <h1 class="page-title">Guides</h1>
  <p class="page-count">{guides.length} {guides.length === 1 ? 'guide' : 'guides'}</p>
  <p class="page-sub">
    Not news-driven like Posts: these get revised in place as the thing they explain changes.
  </p>

  {guides.map((guide) => <PostCard post={guide} kind="guide" />)}

  {guides.length === 0 && <p class="empty">No guides yet.</p>}
</BaseLayout>

<style>
  .page-title {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.028em;
    font-weight: 680;
  }

  .page-count {
    margin: 0.4rem 0 0;
    color: var(--fg-faint);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .page-sub {
    margin: 0.25rem 0 2rem;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
