---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout
  title="Not found"
  description="That page does not exist."
  path="/404"
  narrow
  noindex
>
  <div class="nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">That page does not exist.</h1>
    <p class="nf__text">
      The link may be stale, or the post may have been renamed. Try the
      <a href={withBase('/posts')}>archive</a> or <a href={withBase('/search')}>search</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .nf {
    padding: 4rem 0 6rem;
    text-align: center;
  }

  .nf__code {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .nf__title {
    margin: 0.6rem 0 0;
    font-size: 1.75rem;
    letter-spacing: -0.028em;
    font-weight: 680;
  }

  .nf__text {
    margin: 0.75rem 0 0;
    color: var(--fg-muted);
  }

  .nf__text a {
    color: var(--accent);
  }
</style>
