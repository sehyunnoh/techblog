---
/**
 * Thin bar fixed to the top of the viewport showing how far through the
 * article the reader is. Decorative, so it is hidden from assistive tech.
 * Progress is measured against the article element (not the whole page),
 * so the footer and related links do not count as unread text.
 */
---

<div class="reading-progress" aria-hidden="true" data-pagefind-ignore>
  <div class="reading-progress__bar" data-reading-progress></div>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress__bar {
    height: 100%;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('article');

  if (bar && article) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const top = article.getBoundingClientRect().top + window.scrollY;
      // Distance the reader can scroll while the article is still on screen.
      const span = article.offsetHeight - window.innerHeight;
      const ratio = span > 0 ? (window.scrollY - top) / span : 1;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
