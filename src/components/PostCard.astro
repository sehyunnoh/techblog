---
import type { Post } from '../utils/posts';
import { formatDate, isoDate, readingTime } from '../utils/posts';
import { withBase } from '../utils/url';
import TagBadge from './TagBadge.astro';

interface Props {
  post: Post;
  /** Renders the first entry on the home page larger than the rest. */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const minutes = readingTime(post.body);
---

<article class:list={['card', featured && 'card--featured']}>
  <div class="card__meta">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
    {draft && <span class="card__draft">Draft</span>}
  </div>

  <h2 class="card__title">
    <a href={withBase(`/posts/${post.id}`)}>{title}</a>
  </h2>

  <p class="card__desc">{description}</p>

  <div class="card__tags">
    {tags.map((tag) => <TagBadge tag={tag} />)}
  </div>
</article>

<style>
  .card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .card--featured .card__title {
    font-size: 1.6rem;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .card__draft {
    margin-left: 0.2rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.65rem;
  }

  .card__title {
    margin: 0.4rem 0 0;
    font-size: 1.25rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .card__title a {
    color: var(--fg);
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--accent);
  }

  .card__desc {
    margin: 0.5rem 0 0;
    color: var(--fg-muted);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
</style>
