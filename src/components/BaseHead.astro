---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE, UMAMI_WEBSITE_ID, UMAMI_SCRIPT_URL } from '../consts';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  /** Route-relative path, e.g. `/posts/foo`. Used for the canonical URL. */
  path: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

// The sitemap and every built route are trailing-slash URLs (Astro emits
// dist/foo/index.html for a page at /foo). The canonical tag has to name that
// same exact URL, not a variant of it, even though trailingSlash: 'ignore'
// means both forms serve fine.
const canonicalPath = path === '/' ? path : path.replace(/\/?$/, '/');
const canonical = new URL(withBase(canonicalPath), Astro.site);
const fullTitle = path === '/' ? `${SITE.title} — ${SITE.tagline}` : `${title} · ${SITE.title}`;

/**
 * Post and guide pages get a title/tags card rendered from their own content
 * (src/pages/og/[...slug].png.ts and src/pages/og/guides/[...slug].png.ts);
 * everything else falls back to one generic card so link previews are never
 * empty.
 */
const postSlugMatch = path.match(/^\/posts\/([^/]+)\/?$/);
const guideSlugMatch = path.match(/^\/guides\/([^/]+)\/?$/);
const ogImagePath = postSlugMatch
  ? `/og/${postSlugMatch[1]}.png`
  : guideSlugMatch
    ? `/og/guides/${guideSlugMatch[1]}.png`
    : '/og-default.png';
const ogImage = new URL(withBase(ogImagePath), Astro.site);

/**
 * BlogPosting structured data for article pages, so search engines can show
 * the published/updated date and author without scraping the visible page.
 * Only emitted where there's a real publish date to attach it to.
 */
const jsonLd =
  type === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishedTime.toISOString(),
        dateModified: (modifiedTime ?? publishedTime).toISOString(),
        author: { '@type': 'Person', name: SITE.author },
        publisher: { '@type': 'Organization', name: SITE.title },
        image: ogImage.toString(),
        url: canonical.toString(),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.toString() },
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={new URL(withBase('/rss.xml'), Astro.site)}
/>
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

{
  /*
    Self-hosted: these emit @font-face rules pointing at this origin, so no
    visitor IP is sent to a font CDN. Only the body face is preloaded — the
    monospace face is used by code blocks further down the page.
  */
}
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-jetbrains-mono" />

{
  /*
    Runs before first paint so the page never flashes the wrong theme.
    `is:inline` keeps it out of the bundle and out of the module queue.
  */
}
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch {
      /* Storage can throw in private mode; the light default is fine. */
    }
  })();
</script>

{
  /*
    Analytics is omitted entirely until UMAMI_WEBSITE_ID is set, so local and
    preview builds send nothing.
  */
}
{
  UMAMI_WEBSITE_ID && (
    <script is:inline defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} />
  )
}
